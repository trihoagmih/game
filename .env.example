# Copy to .env. Keep it outside Git. Generate each value independently.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-different-hex-secret
POSTGRES_PASSWORD=replace-with-another-independent-hex-secret
SNAPSHOT_KEY=replace-with-a-third-independent-64-character-hex-secret
APP_PORT=3001
MAX_SPECTATORS_PER_ROOM=30

# Standalone/managed Postgres: configure in host secrets, never commit a real URL.
# DATABASE_URL=postgresql://user:password@host:5432/game

# Set a distinct namespace when deployments share a database.
WORKSPACE_RECORDS_NAMESPACE=b4

# Optional: pull the image CI pushed to GHCR instead of building on this machine.
# Then run: docker compose pull && docker compose up -d --no-build
# GAME_IMAGE=ghcr.io/trihoagmih/game:latest

# Optional: several workspaces, one password each (JSON). When set, APP_PASSWORD is ignored,
# but Compose still requires APP_PASSWORD to be present. Keep the single quotes.
# APP_SERVERS='{"Workspace A":"password-a","Workspace B":"password-b"}'

# Optional: other origins allowed to connect (e.g. a GitHub Pages client). Empty = same origin only.
# CORS_ORIGIN=

# Optional voice chat settings (see README). Empty TURN keys = STUN only.
# VOICE_SERVERS=B4
# CF_TURN_KEY_ID=
# CF_TURN_KEY_API_TOKEN=
# CF_ACCOUNT_ID=
# CF_ANALYTICS_TOKEN=
# VOICE_MAX_PER_ROOM=6
